# Copy to .env and fill in. NEVER commit real keys.
# The Phase-2 notebook hardcoded a CDS key in plain text — do not repeat that.

# Copernicus CDS (only needed to download the REAL ERA5 data; otherwise the
# pipeline runs on the deterministic synthetic fallback).
CDSAPI_KEY=
CDSAPI_URL=https://cds.climate.copernicus.eu/api

# IBM Quantum (free Open Plan token from the IBM Quantum Platform)
QISKIT_IBM_TOKEN=

# qBraid API key (for launching devices/credits from the qBraid account)
QBRAID_API_KEY=
